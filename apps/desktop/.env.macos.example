# Copy to .env.macos (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.tapgo.aicoding
# Tapgo app version advances from the legacy 0.5.319 release; bundled DSH stays at its source version.
TAPGO_DESKTOP_RELEASE_VERSION=0.6.0
DSH_DESKTOP_AUTO_UPDATE_ENV=production
# Stable GitHub Release whose assets are replaced for each arm64 update.
DOWNLOAD_PROD_FEED_URL=https://github.com/chenlaiyi/TapgoAICoding/releases/download/desktop-feed-arm64/
# COS publication instead uses DOWNLOAD_PROD_ORIGIN and the upload scripts.
# DOWNLOAD_PROD_ORIGIN=
# Test releases instead use DSH_DESKTOP_AUTO_UPDATE_ENV=test, DOWNLOAD_TEST_ORIGIN, and a release ID.
# DOWNLOAD_TEST_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
# Generate once per release batch; retain it for retries and versions testing upgrades within that batch.
DOWNLOAD_TEST_RELEASE_ID=

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Workspace tarball workers; omit to use 4. Must be a positive integer.
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
# Optional independent proxy origins; empty values preserve inherited networking.
# Downloads: HTTP/HTTPS proxy for Electron, runtime assets, pnpm and builder downloads.
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Apple tools: HTTP proxy temporarily applied to the active macOS network service.
# Requires permission to change system proxies; affects other applications during notarization.
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

# Tapgo has no mandatory-update policy service. Set this for the derived app.
TAPGO_DESKTOP_NO_POLICY=1
# Matches the existing Tapgo distribution path: Developer ID signed, without Apple notarization.
# Remove this setting and provide notarization credentials plus CSC_LINK for a notarized release.
TAPGO_DESKTOP_SKIP_NOTARIZATION=1
# Only upstream deployments with a policy service use these origins.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
# Set approved login origins for test builds; omit allowedAuthOrigins for production.
# Optional polling and fallback-page options belong in the same JSON value.
# The fallback-page allowlist defaults to the selected service origin.
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=

# Required for notarized releases; compatibility releases use the installed Developer ID identity.
# Local p12 containing the Developer ID Application certificate and private key.
# CSC_KEY_PASSWORD is the p12 export password, not an Apple account or login password.
# An explicitly empty password is accepted for an unencrypted p12.
CSC_LINK=
CSC_KEY_PASSWORD=

# Choose exactly one notarization strategy; leave the others commented out.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Optional upload configuration; packaging does not require these credentials.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=
