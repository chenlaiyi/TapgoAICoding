            <pubDate>Sun, 06 Sep 2026 13:16:43 +0800</pubDate>
            <link>https://github.com/chenlaiyi/TapgoAICoding/releases/tag/v0.5.111</link>
            <sparkle:version>0.5.111</sparkle:version>
